rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- shapes collection ---
    match /shapes/{shapeId} {
      // Anyone can read public shapes; owners can read their own private shapes
      allow read: if resource.data.public == true
                  || request.auth != null && resource.data.userId == request.auth.uid;

      // Authenticated users can create shapes they own
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Owners can update their own shapes
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Owners can delete their own shapes
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // --- users collection ---
    match /users/{userId} {
      // Anyone can read user profiles (for gallery/public pages)
      allow read: if true;

      // Users can only write their own profile
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
