rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- thumbnails ---
    match /thumbnails/{userId}/{fileName} {
      // Anyone can read thumbnails (they're used in the public gallery)
      allow read: if true;

      // Only the owning user can upload, max 2 MB, must be PNG
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/png');
    }

    // Legacy flat thumbnails (read-only for existing shapes)
    match /thumbnails/{fileName} {
      allow read: if true;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
